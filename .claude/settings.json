{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": [
    "shopify-dev"
  ],
  "extraKnownMarketplaces": {
    "shopify-ai-toolkit": {
      "source": {
        "source": "github",
        "repo": "Shopify/shopify-ai-toolkit"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "shopify-plugin@shopify-ai-toolkit": true
  },
  "env": {
    "OPT_OUT_INSTRUMENTATION": "true"
  },
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "mcp__shopify-dev",
      "mcp__shopify-dev__*",
      "Bash(python scripts/*)",
      "Bash(python ./scripts/*)",
      "Bash(python seo/scripts/*)",
      "Bash(python seo/shopify/*)",
      "Bash(python .claude/hooks/test_straznik.py)",
      "Bash(node *shopify-ai-toolkit*search_docs.mjs*)",
      "Bash(node *shopify-ai-toolkit*validate.mjs*)",
      "Bash(shopify version)",
      "Bash(shopify store execute *)",
      "Bash(shopify theme list *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(curl -s *)",
      "Bash(curl -sL *)",
      "PowerShell(python scripts/*)",
      "PowerShell(python scripts\\*)",
      "PowerShell(python .\\scripts\\*)",
      "PowerShell(python seo/scripts/*)",
      "PowerShell(python seo\\scripts\\*)",
      "PowerShell(python seo/shopify/*)",
      "PowerShell(python seo\\shopify\\*)",
      "PowerShell(python .claude/hooks/test_straznik.py)",
      "PowerShell(node *shopify-ai-toolkit*search_docs.mjs*)",
      "PowerShell(node *shopify-ai-toolkit*validate.mjs*)",
      "PowerShell(shopify version)",
      "PowerShell(shopify store execute *)",
      "PowerShell(shopify theme list *)",
      "PowerShell(git status *)",
      "PowerShell(git status)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Date *)",
      "PowerShell(Invoke-WebRequest -UseBasicParsing *)",
      "Edit(./backup/**)",
      "Edit(./raporty/**)",
      "Edit(./robocze/**)",
      "Edit(./dziennik/**)",
      "Edit(./docs/struktura-sklepu.md)",
      "Edit(./docs/struktura-sklepu.json)",
      "WebFetch(domain:florina.pl)",
      "WebFetch(domain:www.florina.pl)",
      "WebFetch(domain:shopify.dev)",
      "WebFetch(domain:help.shopify.com)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:api.baselinker.com)",
      "WebSearch"
    ],
    "ask": [
      "Bash(* --allow-mutations*)",
      "PowerShell(* --allow-mutations*)",
      "Bash(shopify store auth *)",
      "PowerShell(shopify store auth *)",
      "Bash(shopify theme pull *)",
      "PowerShell(shopify theme pull *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git add *)",
      "Bash(pip *)",
      "Bash(npm *)",
      "Bash(winget *)",
      "PowerShell(pip *)",
      "PowerShell(npm *)",
      "PowerShell(winget *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Move-Item *)",
      "PowerShell(Set-Content *)",
      "PowerShell(Out-File *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(del /s *)",
      "Bash(del /q *)",
      "Bash(rd /s *)",
      "Bash(rmdir /s *)",
      "Bash(format *)",
      "Bash(diskpart *)",
      "Bash(shutdown *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(shopify theme push*)",
      "Bash(shopify theme publish*)",
      "Bash(shopify theme delete*)",
      "Bash(shopify theme rename*)",
      "Bash(shopify theme share*)",
      "Bash(shopify theme dev*)",
      "Bash(shopify theme duplicate*)",
      "Bash(shopify theme console*)",
      "Bash(shopify app *)",
      "Bash(shopify auth logout*)",
      "Bash(*szablon_wgraj*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(more *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep * .env*)",
      "Bash(echo *BASELINKER_TOKEN*)",
      "Bash(printenv*)",
      "Bash(env)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(Remove-Item -Recurse *)",
      "PowerShell(Remove-Item * -r *)",
      "PowerShell(Format-Volume *)",
      "PowerShell(Clear-Disk *)",
      "PowerShell(Initialize-Disk *)",
      "PowerShell(Stop-Computer*)",
      "PowerShell(Restart-Computer*)",
      "PowerShell(Set-ExecutionPolicy *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(shopify theme push*)",
      "PowerShell(shopify theme publish*)",
      "PowerShell(shopify theme delete*)",
      "PowerShell(shopify theme rename*)",
      "PowerShell(shopify theme share*)",
      "PowerShell(shopify theme dev*)",
      "PowerShell(shopify theme duplicate*)",
      "PowerShell(shopify theme console*)",
      "PowerShell(shopify app *)",
      "PowerShell(shopify auth logout*)",
      "PowerShell(*szablon_wgraj*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Get-ChildItem Env:*)",
      "Read(./.env)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(~/.ssh/**)",
      "Edit(./.env)",
      "Edit(.env)",
      "Edit(./.mcp.json)",
      "Edit(./.claude/**)",
      "Edit(./scripts/**)",
      "Edit(./seo/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./install.ps1)",
      "Edit(./robocze/motyw/**)",
      "Edit(~/.claude/**)",
      "Edit(//c/Windows/**)",
      "Edit(//c/Program Files/**)",
      "Edit(//c/Program Files (x86)/**)",
      "mcp__claude_ai_Shopify",
      "mcp__claude_ai_Shopify__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/straznik.py"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
