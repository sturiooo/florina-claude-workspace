# Skopiuj ten plik jako .env (zrobi to install.ps1) i uzupelnij. Plik .env NIE trafia do repozytorium.

# Sklep, na ktorym pracujemy
SHOPIFY_STORE=florina-pl.myshopify.com

# Wersja Admin API (bez tego Shopify CLI uzywa wersji "unstable")
SHOPIFY_API_VERSION=2026-07

# Token API BaseLinkera: osobny uzytkownik Base z uprawnieniami TYLKO DO ODCZYTU (patrz INSTALACJA.md, krok 7).
# Wklej sam token, bez cudzyslowow. Nigdy nie wklejaj go do czatu z Claude.
BASELINKER_TOKEN=
